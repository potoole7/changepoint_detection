\@writefile{lof}{\contentsline {figure}{\numberline {8\enspace  }{\ignorespaces  Spatial clustering of the 40 Spanish stations obtained from the fitted conditional extremes dissimilarity matrices. Winter is fitted separately for season-years 1960--1998 and 1999--2024, summer is fitted separately for season-years 1960--1990 and 1991--2024, and autumn is fitted separately for season-years 1960--1986 and 1987--2024. Three clusters are used in each fit. Colours distinguish cluster membership within each panel. Background shading represents elevation. \relax }}{19}{figure.caption.10}\protected@file@percent }
\newlabel{fig:app_clust}{{8\enspace  }{19}{Spatial clustering of the 40 Spanish stations obtained from the fitted conditional extremes dissimilarity matrices. Winter is fitted separately for season-years 1960--1998 and 1999--2024, summer is fitted separately for season-years 1960--1990 and 1991--2024, and autumn is fitted separately for season-years 1960--1986 and 1987--2024. Three clusters are used in each fit. Colours distinguish cluster membership within each panel. Background shading represents elevation. \relax }{figure.caption.10}{}}
