\@writefile{lof}{\contentsline {figure}{\numberline {3\enspace  }{\ignorespaces  Pointwise rejection rates under the null and global-change scenarios for the Frobenius and infinity norms. Red and blue curves correspond to significance levels of 5\% and 10\%, respectively, and the horizontal dashed lines indicate the corresponding nominal levels. The vertical dotted line marks the onset of the gradual change in 1990; in the null panels, it is included only as a reference. Points show the proportion of the 100 simulation replicates rejected at each candidate split point, and vertical bars give 95\% Wilson confidence intervals. \relax }}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sim_global}{{3\enspace  }{8}{Pointwise rejection rates under the null and global-change scenarios for the Frobenius and infinity norms. Red and blue curves correspond to significance levels of 5\% and 10\%, respectively, and the horizontal dashed lines indicate the corresponding nominal levels. The vertical dotted line marks the onset of the gradual change in 1990; in the null panels, it is included only as a reference. Points show the proportion of the 100 simulation replicates rejected at each candidate split point, and vertical bars give 95\% Wilson confidence intervals. \relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4\enspace  }{\ignorespaces  Pointwise rejection rates under the null scenario and the two local-change scenarios for the Frobenius and infinity norms. The local alternatives increase the correlation parameter at the five affected sites from 0.1 towards 0.3 or 0.6. Red and blue curves correspond to significance levels of 5\% and 10\%, respectively, and the horizontal dashed lines indicate the corresponding nominal levels. The vertical dotted line marks the onset of the gradual change in 1990; in the null panels, it is included only as a reference. Points show the proportion of the 100 simulation replicates rejected at each candidate split point, and vertical bars give 95\% Wilson confidence intervals. \relax }}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sim_local}{{4\enspace  }{10}{Pointwise rejection rates under the null scenario and the two local-change scenarios for the Frobenius and infinity norms. The local alternatives increase the correlation parameter at the five affected sites from 0.1 towards 0.3 or 0.6. Red and blue curves correspond to significance levels of 5\% and 10\%, respectively, and the horizontal dashed lines indicate the corresponding nominal levels. The vertical dotted line marks the onset of the gradual change in 1990; in the null panels, it is included only as a reference. Points show the proportion of the 100 simulation replicates rejected at each candidate split point, and vertical bars give 95\% Wilson confidence intervals. \relax }{figure.caption.6}{}}
